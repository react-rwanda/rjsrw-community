# ─────────────────────────────────────────────────────────────────────────────
# React JS Rwanda — Environment Variables
# Copy this file to .env.local and fill in your values. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database — Neon PostgreSQL ─────────────────────────────────────────────
# Neon project dashboard → Connection Details → Pooled connection.
# Format: postgres://USER:PASS@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgres://postgres:Admin@Jos123!@localhost/rjsrw"

# ─── Cache — Upstash Redis (serverless, HTTP) ───────────────────────────────
# Upstash Console → your database → REST API tab.
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# ─── Better Auth — Auth secrets & base URL ──────────────────────────────────
# Generate a 32+ char random secret (e.g. https://randomkeygen.com → CodeIgniter Encryption Key).
BETTER_AUTH_SECRET=""
# Full app URL (no trailing slash). Use http://localhost:3000 in dev.
BETTER_AUTH_URL="http://localhost:3000"

# ─── OAuth providers — Sign in with GitHub or Google ────────────────────────
# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Resend — Transactional email ───────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender (e.g. "info@reactjsrwanda.com" or "React JS Rwanda <noreply@…>")
RESEND_EMAIL_FROM=""

# ─── Cloudflare R2 — File storage (avatars, cover images) ───────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens.
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_BUCKET_NAME=""
# Public URL for objects (custom domain or *.r2.dev).
CLOUDFLARE_R2_PUBLIC_DEV_URL=""

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
